# Variáveis de ambiente — NUNCA commitar
.env
.env.local
.env.*.local

# Backups de dados pessoais (regra específica: um "*.json" genérico esconderia
# qualquer JSON de configuração futuro — vercel.json, firebase.json, etc.)
financas-backup-*.json
*-backup-*.json

# Sistemas operacionais
.DS_Store
Thumbs.db
desktop.ini

# Scripts temporários de calibração/diagnóstico
scripts/tmp-*.mjs
tmp-*.json

# Editores
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Node (caso instale alguma dependência futura)
node_modules/

# Scripts de arrumação pontual: rodam uma vez contra a base e não fazem parte
# do app. Quatro deles chegaram a ser versionados por engano (tmp-arrumar-base,
# tmp-limpar-fatura, tmp-metas, tmp-regras) e saíram na limpeza de 19/09/2026 —
# continuam no histórico do git, que é onde esse tipo de coisa deve morar.
/tmp-*.js
/scripts/

# Sobras do gerador do relatório de auditoria (o PDF em si é versionado)
docs/security-audit/.fatias/
docs/security-audit/.chrome-perfil*/
docs/security-audit/relatorio.html
